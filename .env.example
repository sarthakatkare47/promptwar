# InvoiceGuard+ Environment Variables
# Copy this file to backend/.env and populate with your settings

# Google Gemini API Settings (server-side only, never share or commit)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXTRACTOR=gemini
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Pricing for cost metrics (USD per 1M tokens) - leave empty if not configured
GEMINI_PRICE_INPUT_PER_MTOK_USD=
GEMINI_PRICE_OUTPUT_PER_MTOK_USD=

# Cost and Rate Control Limits
DAILY_AI_CALL_LIMIT=200
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Upload Security Limits
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=5
MAX_IMAGE_PIXELS=40000000

# Persistence Paths (relative to backend/)
DATABASE_PATH=data/invoiceguard.db
UPLOAD_DIR=data/uploads
MOCK_FIXTURES_DIR=benchmark/dataset/labels

# Server Security and CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IG_ACCESS_TOKEN=
LOG_LEVEL=INFO

# Deterministic Validation Tolerances
AMOUNT_TOLERANCE_INR=1.00
CGST_SGST_TOLERANCE_INR=0.05
OLD_INVOICE_DAYS=730
